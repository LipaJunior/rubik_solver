# Szablon zmiennych srodowiskowych do lokalnego uruchomienia.
# Skopiuj ten plik do .env.local i uzupelnij prawdziwe wartosci:
#     cp .env.local.example .env.local
# .env.local jest w .gitignore - Twoje haslo NIE trafi do repozytorium.

# --- Baza danych (Neon / Postgres) ---
# DB_URL musi miec prefiks jdbc: oraz ?sslmode=require (bez &channel_binding=require).
DB_URL=jdbc:postgresql://HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASS=WKLEJ_TUTAJ_HASLO_Z_NEON

# --- (opcjonalnie, przydadza sie w kolejnych etapach) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
